# Native Compose Settings at Search engine; cookie list initially enabled.
# Restores the optional list to enabled without restarting or resetting data.
wait "text=\"Search engine\" focused=true" 3000
tv-remote down
wait "text=\"Content Filters\" focused=true" 3000
tv-remote select
wait "text=\"Cookie notice blocker: On\" focused=true" 3000
tv-remote select
wait "text=\"Cookie notice blocker: Off\" focused=true" 3000
tv-remote select
wait "text=\"Cookie notice blocker: On\" focused=true" 3000
tv-remote back
wait "text=\"Content Filters\" focused=true" 3000
