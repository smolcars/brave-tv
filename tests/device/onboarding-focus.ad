# Requires an incomplete first run showing the Web Discovery page on a TV.
# Does not clear app data or opt into Web Discovery.
open com.brave.browser_default --relaunch
wait "id=\"com.brave.browser_default:id/onboarding_later\""
tv-remote down
tv-remote down
tv-remote left
wait "id=\"com.brave.browser_default:id/onboarding_later\" focused=true" 3000
tv-remote select
wait "id=\"com.brave.browser_default:id/onboarding_continue\""
