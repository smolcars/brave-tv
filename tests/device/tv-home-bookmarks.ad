# Normal Ambient Home, Search focused, baseline text; bookmark data is only read.
wait "text=\"Search or enter a website\" focused=true" 3000
tv-remote up
wait "text=\"Home\" focused=true" 3000
tv-remote right
tv-remote right
wait "text=\"Favorites\" focused=true" 3000
tv-remote select
wait "text=\"Browser controls\"" 3000
tv-remote back
wait "text=\"Favorites\" focused=true" 3000
