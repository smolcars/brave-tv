# Normal home with Address focused; opening a real model panel must attach before composition.
wait "text=\"Address or search\" focused=true" 3000
tv-remote down
wait "text=\"Browser controls\" focused=true" 3000
tv-remote select
wait "text=\"Address or search\" focused=true" 3000
tv-remote down
tv-remote right
wait "text=\"Tabs\" focused=true" 3000
tv-remote select
wait "text=\"New tab\" focused=true" 3000
tv-remote back
wait "text=\"Tabs\" focused=true" 3000
tv-remote right
wait "text=\"Bookmarks\" focused=true" 3000
tv-remote select
wait "text=\"More bookmarks\"" 3000
