# Normal Ambient Home, Search focused; native model panels attach before composition.
wait "text=\"Search or enter a website\" focused=true" 3000
tv-remote up
wait "text=\"Home\" focused=true" 3000
tv-remote right
wait "text=\"Tabs\" focused=true" 3000
tv-remote select
wait "text=\"New tab\" focused=true" 3000
tv-remote back
wait "text=\"Tabs\" focused=true" 3000
tv-remote right
wait "text=\"Favorites\" focused=true" 3000
tv-remote select
wait "text=\"More bookmarks\"" 3000
