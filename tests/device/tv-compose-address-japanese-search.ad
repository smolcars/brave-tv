# Fixed fixture precondition: normal Home editor, DuckDuckGo selected, native IME supplied 日本.
# Hide the IME and focus Go before replay. The native controls URL is the selected-tab postcondition.
wait "text=\"Search with DuckDuckGo, or enter a web address.\"" 3000
wait "value=\"日本\" editable=true" 3000
wait "text=\"Go\" focused=true" 3000
tv-remote select
wait absent "text=\"Clear\"" 3000
tv-remote back
wait "text=\"https://duckduckgo.com/?q=%E6%97%A5%E6%9C%AC&t=brave&ia=web\"" 3000
