# Requires a loaded webpage. Native D-pad focus, not pointer-source acceptance.
open com.brave.browser_default --relaunch
wait "text=\"Search or enter a website\" focused=true" 5000
tv-remote right
wait "text=\"Browse page\" focused=true" 3000
tv-remote left
wait "text=\"Search or enter a website\" focused=true" 3000
tv-remote down
tv-remote down
wait "text=\"Tabs\" focused=true" 3000
tv-remote select
wait "text=\"New tab\" focused=true" 3000
tv-remote right
wait "text=\"Private tabs\" focused=true" 3000
tv-remote select
wait "text=\"Normal tabs\"" 3000
tv-remote back
wait "text=\"Tabs\" focused=true" 3000
