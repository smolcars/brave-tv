# Requires a normal native home tab; opens a private new tab without closing existing tabs.
wait "text=\"Where to next?\"" 5000
wait "text=\"Search or enter a website\" focused=true" 3000
tv-remote up
wait "text=\"Home\" focused=true" 3000
tv-remote right
wait "text=\"Tabs\" focused=true" 3000
tv-remote select
wait "text=\"New tab\" focused=true" 3000
tv-remote right
wait "text=\"Private tabs\" focused=true" 3000
tv-remote select
wait "text=\"New tab\" focused=true" 3000
tv-remote select
wait "text=\"Pages in this session are not saved to browsing history. Websites and your network provider can still see your activity.\"" 5000
wait "text=\"Search or enter a website\" focused=true" 3000
