# Requires a normal native home tab; never clears browser/profile data.
open com.brave.browser_default --relaunch
wait "text=\"Address or search\" focused=true" 5000
tv-remote right
wait "text=\"Browser controls\" focused=true" 3000
tv-remote up
wait "id=\"com.brave.browser_default:id/tab_switcher_button\" focused=true" 3000
tv-remote right
wait "text=\"Customize and control Google Chrome\" focused=true" 3000
tv-remote select
wait "text=\"Browser controls\"" 3000
wait "text=\"Tabs\"" 3000
