# Active normal tab: dialogs.html with no history; no media session created.
open com.brave.browser_default --relaunch
wait "text=\"Address or search\" focused=true" 5000
tv-remote down
tv-remote down
tv-remote down
tv-remote down
wait "text=\"Playback\" focused=true" 3000
tv-remote select
wait "text=\"Browser controls\" focused=true" 3000
tv-remote back
wait "text=\"Playback\" focused=true" 3000
