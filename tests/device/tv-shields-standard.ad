# Normal shields.html tab active; protection on, Aggressive selected, no page history.
open com.brave.browser_default --relaunch
wait "text=\"Address or search\" focused=true" 5000
tv-remote down
wait "text=\"Page cursor\" focused=true" 3000
tv-remote down
wait "text=\"Bookmarks\" focused=true" 3000
tv-remote down
wait "text=\"Site protection\" focused=true" 3000
tv-remote select
wait "text=\"Protection on · Turn off for this site\" focused=true" 3000
tv-remote down
wait "text=\"Standard blocking\" focused=true" 3000
tv-remote select
wait "text=\"Protection on · Turn off for this site\" focused=true" 3000
tv-remote down
wait "text=\"Aggressive blocking\" focused=true" 3000
