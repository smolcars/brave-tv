# Requires normal native home; opens the native tab list without changing profile data.
wait "text=\"Where to next?\"" 5000
wait "text=\"Search or enter a website\" focused=true" 3000
tv-remote up
wait "text=\"Home\" focused=true" 3000
tv-remote right
wait "text=\"Tabs\" focused=true" 3000
tv-remote select
wait "text=\"New tab\" focused=true" 3000
wait "text=\"Private tabs\"" 3000
wait "text=\"Browser controls\"" 3000
# The preserved regression profile has two fixture tabs before the active home.
tv-remote down
tv-remote down
tv-remote down
wait "text=\"Current: Home\" focused=true" 3000
tv-remote select
wait "text=\"Search or enter a website\" focused=true" 3000
