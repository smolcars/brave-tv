# Requires the current Compose normal Home; never clears browser/profile data.
open com.brave.browser_default --relaunch
wait "text=\"The web. On your terms.\"" 5000
wait "text=\"Address or search\" focused=true" 3000
tv-remote down
wait "text=\"Browser controls\" focused=true" 3000
tv-remote right
wait "text=\"Tabs\" focused=true" 3000
tv-remote right
wait "text=\"Bookmarks\" focused=true" 3000
tv-remote right
wait "text=\"Settings\" focused=true" 3000
tv-remote select
wait "text=\"Search engine\" focused=true" 3000
tv-remote back
wait "text=\"Settings\" focused=true" 3000
tv-remote left
wait "text=\"Bookmarks\" focused=true" 3000
tv-remote left
wait "text=\"Tabs\" focused=true" 3000
tv-remote left
wait "text=\"Browser controls\" focused=true" 3000
tv-remote select
wait "text=\"Address or search\" focused=true" 3000
wait "text=\"Tabs\"" 3000
