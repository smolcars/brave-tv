tv-remote up
wait "text=\"Home\" focused=true" 3000
tv-remote right
wait "text=\"Tabs\" focused=true" 3000
tv-remote right
wait "text=\"Favorites\" focused=true" 3000
tv-remote right
wait "text=\"Phone\" focused=true" 3000
tv-remote right
wait "text=\"Settings\" focused=true" 3000
tv-remote select
wait "text=\"Search engine\" focused=true" 3000
tv-remote back
wait "text=\"Settings\" focused=true" 3000
tv-remote right
wait "text=\"Browser controls\" focused=true" 3000
tv-remote select
